{
  "expo": {
    "name": "SportnNote",
    "slug": "sportnnote",
    "version": "1.0.0",
    "scheme": "sportnnote",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "in.sportnnote.app",
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "SportnNote uses the microphone for hands-free voice scoring. Audio isn’t recorded or uploaded by SportnNote — only the recognized words are used.",
        "NSSpeechRecognitionUsageDescription": "SportnNote uses speech recognition to turn your spoken calls (like “goal Rao”) into score entries.",
        "NSContactsUsageDescription": "Allow SportnNote to open your contacts so you can pick a player’s mobile number. Only the contact you pick is used."
      }
    },
    "android": {
      "package": "in.sportnnote.app",
      "adaptiveIcon": {
        "backgroundColor": "#0E1116",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "READ_CONTACTS",
        "RECORD_AUDIO"
      ],
      "predictiveBackGestureEnabled": false,
      "googleServicesFile": "./google-services.json",
      "blockedPermissions": [
        "android.permission.WRITE_CONTACTS"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "app.sportnnote.in",
              "pathPrefix": "/m/"
            },
            {
              "scheme": "https",
              "host": "app.sportnnote.in",
              "pathPrefix": "/t/"
            },
            {
              "scheme": "https",
              "host": "app.sportnnote.in",
              "pathPrefix": "/p/"
            },
            {
              "scheme": "https",
              "host": "app.sportnnote.in",
              "pathPrefix": "/g/"
            },
            {
              "scheme": "https",
              "host": "app.sportnnote.in",
              "pathPrefix": "/r/"
            },
            {
              "scheme": "https",
              "host": "app.sportnnote.in",
              "pathPrefix": "/c/"
            },
            {
              "scheme": "https",
              "host": "app.sportnnote.in",
              "pathPrefix": "/pp"
            },
            {
              "scheme": "https",
              "host": "app.sportnnote.in",
              "pathPrefix": "/h/"
            },
            {
              "scheme": "https",
              "host": "app.sportnnote.in",
              "pathPrefix": "/i/"
            },
            {
              "scheme": "https",
              "host": "app.sportnnote.in",
              "pathPrefix": "/get"
            },
            {
              "scheme": "https",
              "host": "app.sportnnote.in",
              "pathPrefix": "/join/"
            },
            {
              "scheme": "https",
              "host": "app.sportnnote.in",
              "pathPrefix": "/join-club/"
            },
            {
              "scheme": "https",
              "host": "app.sportnnote.in",
              "pathPrefix": "/join-tournament/"
            },
            {
              "scheme": "https",
              "host": "app.sportnnote.in",
              "pathPrefix": "/guardian-consent"
            },
            {
              "scheme": "https",
              "host": "app.sportnnote.in",
              "pathPrefix": "/org-confirm"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "name": "SportnNote",
      "shortName": "SportnNote",
      "themeColor": "#0E1116",
      "backgroundColor": "#0E1116"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#3DDC97"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow SportnNote to use the camera to scan a team invite QR code."
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Allow SportnNote to open your contacts so you can pick a player’s mobile number. Only the contact you pick is used."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "SportnNote uses the microphone for hands-free voice scoring. Audio isn’t recorded or uploaded by SportnNote — only the recognized words are used.",
          "speechRecognitionPermission": "SportnNote uses speech recognition to turn your spoken calls (like “goal Rao”) into score entries.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox",
            "com.google.android.tts",
            "com.google.android.as"
          ]
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/auth"
    ],
    "extra": {
      "eas": {
        "projectId": "68dfbfe5-0345-47c8-8a13-65246aa42fc3"
      }
    },
    "owner": "sportnnote.in",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/68dfbfe5-0345-47c8-8a13-65246aa42fc3"
    }
  }
}
