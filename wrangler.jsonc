// Cloudflare Workers config for the marketing site sportnnote.in (static assets,
// built by `node scripts/build-website.mjs` → website/dist; see docs/website.md)
// and one code route: the live score link app.sportnnote.in/m/<match>
// (worker/index.ts, MVP 2026-10-31; Cloudflare steps in docs/launch/live-link.md).
// The app itself is NOT deployed here (it's on EAS Hosting).
{
  "name": "sportnnote",
  "compatibility_date": "2026-10-01",
  "main": "worker/index.ts",
  "assets": {
    "directory": "./website/dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // The match links run the Worker first: otherwise a browser opening one
    // (a page navigation) is answered by the static site's 404 page.
    "run_worker_first": ["/m/*"]
  },
  // Public values, the same ones every visitor's browser gets from the web app.
  "vars": {
    "SUPABASE_URL": "https://mpgbvbylmkwasjgupsbq.supabase.co",
    "SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im1wZ2J2YnlsbWt3YXNqZ3Vwc2JxIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODYwMjIxNDQsImV4cCI6MjEwMTU5ODE0NH0.NV7ryMBv-qAc7OzHZVPPxXY2J3agtlHRbvS55R6sWXw"
  }
}
